  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Il est possible d\u2019importer et d\u2019exporter des niveaux.\n\nExportation
    :\nUne fois le niveau termin\xE9 et que vous souhaitez l\u2019exporter, s\xE9lectionnez-le
    dans la cat\xE9gorie \xAB Charger une sauvegarde \xBB, puis appuyez sur Exporter.
    Un dossier s\u2019ouvre ; vous y trouverez votre fichier au format JSON, pr\xEAt
    \xE0 \xEAtre export\xE9.\n\nImportation :\nPour importer un niveau, allez dans
    le dossier \xAB Importer \xBB et ins\xE9rez votre fichier JSON. Revenez ensuite
    sur l\u2019\xE9cran principal, actualisez et cliquez sur Importer. Actualisez
    enfin le menu \xAB Charger une sauvegarde \xBB, puis s\xE9lectionnez le niveau
    import\xE9."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
